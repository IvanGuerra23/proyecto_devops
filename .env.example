# Copia este archivo como .env y ajusta los valores para tu entorno.
# Docker Compose ya trae valores por defecto, así que .env es opcional.

# Puertos expuestos en el host
APP_PORT=5000
MYSQL_PORT=3307
ADMINER_PORT=8081
PROMETHEUS_PORT=9090

# Imagen de la aplicación (por ejemplo, la publicada en GHCR)
# APP_IMAGE=ghcr.io/ivanguerra23/proyecto_devops:latest

# Credenciales de MySQL (evita caracteres especiales en este demo)
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=devops_db
MYSQL_USER=devops
MYSQL_PASSWORD=devops123

# Clave de Flask
SECRET_KEY=cambia-esta-clave-en-produccion

# Carga datos de ejemplo si la base está vacía
SEED_DATA=true

# Nivel de log estructurado (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Opcional: ejecutar la app fuera de Docker contra el MySQL de Compose
# DATABASE_URL=mysql+pymysql://devops:devops123@127.0.0.1:3307/devops_db?charset=utf8mb4
